# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local handoff doc — contains a live API key, never commit
HANDOFF.md

# Credential written into the project dir by an external tool; never commit.
# Anchored to the repo root: an unanchored "data/" also matches src/data/,
# which silently excluded the committed datasets the app imports at build time.
/data/

# Raw Convoke MCP responses, the working input to scripts/build-programs.mjs.
# Intermediates, not the artifact — src/data/programs.json is what the app
# reads. This repo has a public mirror, and these are bulk extracts of a
# third-party knowledge graph; regenerate them per RUNBOOK.md instead.
/tmp/
